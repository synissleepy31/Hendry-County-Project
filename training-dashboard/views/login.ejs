<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HCP Interactive Training</title>

    <!-- TAB / BROWSER ICON -->
    <link rel="icon" type="image/png" href="/public/images/HCPIT.png">

    <!-- CSS -->
    <link rel="stylesheet" href="/public/css/training.css">
</head>

<body>

    <main class="training-login-page">

        <section class="training-login-card">

            <!-- LOGO -->
            <div class="training-login-logo">
                <img
                    src="/public/images/HCPIT.png"
                    alt="Hendry County Interactive Training"
                >
            </div>


            <div class="training-eyebrow">
                HENDRY COUNTY PROJECT
            </div>


            <h1 class="training-login-title">
                Interactive
                <span>Training</span>
            </h1>


            <p class="training-login-description">
                Sign in with Discord to access the
                Hendry County Project Interactive Training
                and assessment platform.
            </p>


            <a
                href="/auth/discord"
                class="training-login-button"
            >
                Login with Discord
            </a>


            <div class="training-secure-text">
                Secure authentication through Discord
            </div>

        </section>

    </main>

</body>

</html>