<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Live FTO | <%= session.assessment_name %></title>

    <link rel="icon" type="image/png" href="/public/images/HCPIT.png">
    <link rel="stylesheet" href="/public/css/training.css">
</head>

<body>

<header class="training-topbar">

    <a href="/training" class="training-brand">
        <div class="training-brand-logo">
            <img src="/public/images/HCPIT.png" alt="HCP">
        </div>

        <div class="training-brand-text">
            <strong>Hendry County</strong>
            <span>Interactive Training</span>
        </div>
    </a>

    <nav class="training-nav">
        <a href="/training">Home</a>
        <a href="/training/schedule">Schedule</a>
        <a href="/training/fto-review">FTO Review</a>
    </nav>

    <div class="training-user-box">
        <img src="<%= user.avatar %>" alt="<%= user.displayName %>">

        <div class="training-user-info">
            <strong><%= user.displayName %></strong>
            <span>FTO Live Control</span>
        </div>
    </div>

</header>

<div
    id="liveConnectionBanner"
    class="live-connection-banner"
    hidden
>
    Reconnecting to the live session…
</div>



<main class="live-shell">

    <aside class="live-sidebar">

        <div class="live-session-label">
            <span class="live-dot"></span>
            LIVE SESSION
        </div>

        <h2>
            <%= session.assessment_name %>
        </h2>

        <p>
            <%= session.department_code %>
            ·
            Code
            <strong><%= session.join_code %></strong>
        </p>


        <div class="live-side-heading">
            SECTIONS
        </div>


        <div class="live-section-list">

            <% sections.forEach((section, index) => { %>

                <button
                    type="button"
                    class="live-section-button <%= Number(state.current_section_id) === Number(section.id) ? 'active' : '' %>"
                    data-section-id="<%= section.id %>"
                    onclick="changeSection(<%= section.id %>)"
                >
                    <span>
                        <%= index + 1 %>
                    </span>

                    <div>
                        <strong>
                            <%= section.title %>
                        </strong>

                        <small>
                            <%= section.section_type %>
                        </small>
                    </div>
                </button>

            <% }) %>

        </div>


        <div class="live-side-heading">
            PRESENT
        </div>

        <div
            id="participantList"
            class="live-participants"
        ></div>

    </aside>


    <section class="live-main">

        <div class="live-main-top">

            <div>
                <div class="training-eyebrow">
                    <%= session.department_code %> · FTO VIEW
                </div>

                <h1>
                    <%= session.assessment_name %>
                </h1>
            </div>

            <a
                href="/training/schedule/<%= session.id %>"
                class="schedule-action-button discord"
            >
                Session Details
            </a>

        </div>


        <% if (typeof error !== "undefined" && error) { %>

            <div class="training-alert error">
                <%= error %>
            </div>

        <% } %>


        <% sections.forEach((section, index) => { %>

            <% const sectionQuestions = questionsBySection[String(section.id)] || []; %>

            <article
                class="live-section-panel <%= Number(state.current_section_id) === Number(section.id) ? 'active' : '' %>"
                data-panel-id="<%= section.id %>"
                data-question-count="<%= sectionQuestions.length %>"
            >

                <div class="live-section-counter">
                    SECTION <%= index + 1 %>
                    OF <%= sections.length %>
                </div>

                <h2>
                    <%= section.title %>
                </h2>


                <div class="live-content-box">

                    <div class="live-box-label">
                        TRAINEE CONTENT
                    </div>

                    <div class="live-rich-content">
                        <%- section.trainee_content || '<p>No trainee content.</p>' %>
                    </div>

                </div>


                <div class="live-fto-notes">

                    <div class="live-box-label">
                        FTO-ONLY READ-OUT NOTES
                    </div>

                    <div class="live-rich-content">
                        <%- section.fto_notes || '<p>No private FTO notes.</p>' %>
                    </div>

                </div>


                <% if (sectionQuestions.length) { %>

                    <section class="live-fto-quiz-control">

                        <div>

                            <div class="training-eyebrow">
                                LIVE ASSESSMENT
                            </div>

                            <h3>
                                <%= sectionQuestions.length %>
                                question<%= sectionQuestions.length === 1 ? '' : 's' %>
                            </h3>

                            <p>
                                Open the questions when you are ready for trainees to answer.
                            </p>

                        </div>


                        <button
                            type="button"
                            class="schedule-action-button start live-quiz-toggle"
                            data-section-id="<%= section.id %>"
                            onclick="toggleQuiz()"
                        >
                            Open Questions
                        </button>

                    </section>


                    <section class="live-response-panel">

                        <div class="live-response-heading">

                            <strong>
                                LIVE RESPONSES
                            </strong>

                            <span
                                class="live-response-count"
                                data-response-count="<%= section.id %>"
                            >
                                0 submitted
                            </span>

                        </div>


                        <div
                            class="live-response-list"
                            data-response-list="<%= section.id %>"
                        >
                            <div class="live-response-empty">
                                Waiting for trainee answers.
                            </div>
                        </div>

                    </section>

                <% } %>

            </article>

        <% }) %>


        <div class="live-controls">

            <button
                type="button"
                class="schedule-action-button discord"
                onclick="moveSection(-1)"
            >
                ← Previous
            </button>


            <div id="syncStatus">
                Trainees synced
            </div>


            <button
                type="button"
                class="schedule-action-button start"
                onclick="moveSection(1)"
            >
                Next →
            </button>


            <button
                type="button"
                class="schedule-action-button complete"
                onclick="openFinishCheck()"
            >
                ✓ Finish Training
            </button>


            <form
                id="liveFinalizationForm"
                method="POST"
                action="/training/live/<%= session.id %>/finalize"
                class="live-finish-form"
                style="display:none;"
            >

            </form>

        </div>

    </section>

</main>


<div
    id="liveFinishModal"
    class="training-modal-backdrop"
>
    <div class="training-modal live-finish-modal">

        <div class="training-modal-header">

            <div>
                <div class="training-eyebrow">
                    FINALIZATION CHECK
                </div>

                <h2>
                    Finish Live Training
                </h2>
            </div>

            <button
                type="button"
                class="training-modal-close"
                onclick="closeFinishCheck()"
            >
                ×
            </button>

        </div>


        <p class="live-finish-description">
            Check every present trainee before official results are created.
            Missing automatic answers score zero. Unmarked written/practical items
            go to FTO Review instead of receiving an immediate PASS/FAIL.
        </p>


        <div
            id="liveFinishTrainees"
            class="live-finish-trainee-list"
        >
            Loading trainee status…
        </div>


        <div class="live-finish-actions">

            <button
                type="button"
                class="schedule-action-button discord"
                onclick="closeFinishCheck()"
            >
                Keep Training
            </button>


            <button
                id="confirmFinishTraining"
                type="button"
                class="schedule-action-button complete"
                onclick="confirmFinishTrainingNow()"
            >
                Create Official Results
            </button>

        </div>

    </div>
</div>


<script>

    const sessionId =
        <%= session.id %>;


    const sectionIds =
        <%- JSON.stringify(sections.map(section => Number(section.id))) %>;


    let currentSectionId =
        <%= state.current_section_id ? Number(state.current_section_id) : "null" %>;


    let quizOpen =
        <%= Number(state.quiz_open) ? "true" : "false" %>;


    async function openFinishCheck() {

        const modal =
            document.getElementById(
                "liveFinishModal"
            );


        const list =
            document.getElementById(
                "liveFinishTrainees"
            );


        const confirmButton =
            document.getElementById(
                "confirmFinishTraining"
            );


        modal.classList.add(
            "open"
        );


        list.innerHTML =
            '<div class="live-response-empty">Checking present trainees…</div>';


        confirmButton.disabled =
            true;


        try {

            const response =
                await fetch(
                    `/training/live/${sessionId}/preflight`
                );


            const result =
                await response.json();


            if (
                !result.ok
            ) {

                list.innerHTML =
                    '<div class="training-alert error">Could not check trainee readiness.</div>';

                return;
            }


            const trainees =
                result.trainees ||
                [];


            if (
                !trainees.length
            ) {

                list.innerHTML =
                    '<div class="training-alert error">No trainees are currently marked Present.</div>';

                return;
            }


            list.innerHTML =
                trainees.map(
                    trainee => {

                        const pending =
                            trainee.projectedStatus ===
                            "pending_review";


                        const statusText =
                            pending
                                ? "PENDING FTO REVIEW"
                                : "READY FOR RESULT";


                        return `
                            <article class="live-finish-trainee ${pending ? "pending" : "ready"}">

                                <div>
                                    <strong>
                                        ${escapeHtml(trainee.display_name || trainee.username)}
                                    </strong>

                                    <span>
                                        ${trainee.answered}/${trainee.questionCount} questions submitted
                                    </span>
                                </div>


                                <div class="live-finish-trainee-stats">

                                    <span>
                                        Missing Auto
                                        <strong>${trainee.missingAutomatic}</strong>
                                    </span>

                                    <span>
                                        Unmarked Manual
                                        <strong>${trainee.unmarkedManual}</strong>
                                    </span>

                                </div>


                                <b>
                                    ${statusText}
                                </b>

                            </article>
                        `;
                    }
                )
                .join(
                    ""
                );


            confirmButton.disabled =
                false;


        } catch {

            list.innerHTML =
                '<div class="training-alert error">Could not check trainee readiness.</div>';
        }
    }


    function closeFinishCheck() {

        document
            .getElementById(
                "liveFinishModal"
            )
            .classList.remove(
                "open"
            );
    }


    function confirmFinishTrainingNow() {

        const button =
            document.getElementById(
                "confirmFinishTraining"
            );


        button.disabled =
            true;


        button.textContent =
            "Creating Results…";


        document
            .getElementById(
                "liveFinalizationForm"
            )
            .submit();
    }


    function escapeHtml(value) {

        const div =
            document.createElement(
                "div"
            );

        div.textContent =
            value ||
            "";

        return div.innerHTML;
    }


    function showSection(
        sectionId
    ) {

        currentSectionId =
            Number(
                sectionId
            );


        document
            .querySelectorAll(
                ".live-section-panel"
            )
            .forEach(
                panel => {

                    panel.classList.toggle(
                        "active",
                        Number(
                            panel.dataset.panelId
                        ) ===
                        currentSectionId
                    );
                }
            );


        document
            .querySelectorAll(
                ".live-section-button"
            )
            .forEach(
                button => {

                    button.classList.toggle(
                        "active",
                        Number(
                            button.dataset.sectionId
                        ) ===
                        currentSectionId
                    );
                }
            );


        updateQuizButton();

        refreshResponses();
    }


    function currentPanel() {

        return document.querySelector(
            `.live-section-panel[data-panel-id="${currentSectionId}"]`
        );
    }


    function updateQuizButton() {

        const panel =
            currentPanel();


        if (!panel) {
            return;
        }


        const button =
            panel.querySelector(
                ".live-quiz-toggle"
            );


        if (!button) {
            return;
        }


        button.textContent =
            quizOpen
                ? "Close Questions"
                : "Open Questions";


        button.classList.toggle(
            "cancel",
            quizOpen
        );
    }


    async function changeSection(
        sectionId
    ) {

        const response =
            await fetch(
                `/training/live/${sessionId}/section`,
                {
                    method:
                        "POST",

                    headers: {
                        "Content-Type":
                            "application/x-www-form-urlencoded"
                    },

                    body:
                        new URLSearchParams({
                            section_id:
                                String(
                                    sectionId
                                )
                        })
                }
            );


        const result =
            await response.json();


        if (!result.ok) {
            alert(
                result.message ||
                "Could not change section."
            );

            return;
        }


        quizOpen =
            false;


        showSection(
            sectionId
        );
    }


    function moveSection(
        direction
    ) {

        const index =
            sectionIds.indexOf(
                Number(
                    currentSectionId
                )
            );


        const nextIndex =
            index +
            direction;


        if (
            nextIndex < 0 ||
            nextIndex >=
            sectionIds.length
        ) {
            return;
        }


        changeSection(
            sectionIds[
                nextIndex
            ]
        );
    }


    async function toggleQuiz() {

        const response =
            await fetch(
                `/training/live/${sessionId}/quiz`,
                {
                    method:
                        "POST",

                    headers: {
                        "Content-Type":
                            "application/x-www-form-urlencoded"
                    },

                    body:
                        new URLSearchParams({
                            open:
                                quizOpen
                                    ? "0"
                                    : "1"
                        })
                }
            );


        const result =
            await response.json();


        if (!result.ok) {
            alert(
                "Could not change the live question state."
            );

            return;
        }


        quizOpen =
            Boolean(
                result.quizOpen
            );


        updateQuizButton();
    }


    async function saveManualMark(
        answerId,
        maxMarks
    ) {

        const marksInput =
            document.getElementById(
                `liveMarks_${answerId}`
            );


        const notesInput =
            document.getElementById(
                `liveNotes_${answerId}`
            );


        const response =
            await fetch(
                `/training/live/${sessionId}/mark`,
                {
                    method:
                        "POST",

                    headers: {
                        "Content-Type":
                            "application/x-www-form-urlencoded"
                    },

                    body:
                        new URLSearchParams({
                            answer_id:
                                String(
                                    answerId
                                ),

                            marks:
                                marksInput.value,

                            notes:
                                notesInput.value
                        })
                }
            );


        const result =
            await response.json();


        if (!result.ok) {
            alert(
                result.message ||
                "Could not save that mark."
            );

            return;
        }


        const button =
            document.getElementById(
                `liveSave_${answerId}`
            );


        button.textContent =
            "Saved ✓";


        setTimeout(
            () => {
                button.textContent =
                    "Save Mark";
            },
            1200
        );
    }


    async function refreshResponses() {

        const panel =
            currentPanel();


        if (
            !panel ||
            Number(
                panel.dataset.questionCount
            ) ===
            0
        ) {
            return;
        }


        try {
            const response =
                await fetch(
                    `/training/live/${sessionId}/responses?section_id=${currentSectionId}`
                );


            const result =
                await response.json();


            if (!result.ok) {
                return;
            }


            const rows =
                result.responses ||
                [];


            const list =
                panel.querySelector(
                    `[data-response-list="${currentSectionId}"]`
                );


            const count =
                panel.querySelector(
                    `[data-response-count="${currentSectionId}"]`
                );


            const users =
                new Set(
                    rows.map(
                        row =>
                            row.user_id
                    )
                );


            count.textContent =
                `${users.size} submitted`;


            if (!rows.length) {

                list.innerHTML =
                    '<div class="live-response-empty">Waiting for trainee answers.</div>';

                return;
            }


            list.innerHTML =
                rows.map(
                    row => {

                        const automatic =
                            !Number(
                                row.requires_manual_marking
                            );


                        const status =
                            automatic
                                ? (
                                    Number(
                                        row.is_correct
                                    ) === 1
                                        ? "CORRECT"
                                        : "INCORRECT"
                                )
                                : "FTO MARKING";


                        const score =
                            row.awarded_marks ===
                            null
                                ? `— / ${Number(row.max_marks)}`
                                : `${Number(row.awarded_marks)} / ${Number(row.max_marks)}`;


                        const marking =
                            automatic
                                ? `
                                    <div class="live-auto-result ${Number(row.is_correct) === 1 ? "correct" : "incorrect"}">
                                        <strong>${score}</strong>
                                        <span>${status}</span>
                                    </div>
                                `
                                : `
                                    <div class="live-manual-mark-grid">
                                        <label>
                                            Marks
                                            <input
                                                id="liveMarks_${row.id}"
                                                type="number"
                                                min="0"
                                                max="${Number(row.max_marks)}"
                                                step="0.5"
                                                value="${row.awarded_marks === null ? "" : Number(row.awarded_marks)}"
                                                placeholder="0"
                                            >
                                        </label>

                                        <label>
                                            FTO Notes
                                            <input
                                                id="liveNotes_${row.id}"
                                                type="text"
                                                value="${escapeHtml(row.fto_notes || "")}"
                                                placeholder="Optional feedback..."
                                            >
                                        </label>

                                        <button
                                            id="liveSave_${row.id}"
                                            type="button"
                                            class="schedule-action-button start"
                                            onclick="saveManualMark(${row.id}, ${Number(row.max_marks)})"
                                        >
                                            Save Mark
                                        </button>
                                    </div>
                                `;


                        return `
                            <article class="live-response-card">

                                <div class="live-response-user">

                                    <img
                                        src="${row.avatar_url || "https://cdn.discordapp.com/embed/avatars/0.png"}"
                                        alt=""
                                    >

                                    <div>
                                        <strong>
                                            ${escapeHtml(row.display_name || row.username)}
                                        </strong>

                                        <span>
                                            ${escapeHtml(row.question_type.replaceAll("_", " ").toUpperCase())}
                                        </span>
                                    </div>

                                </div>


                                <div class="live-response-question">

                                    <strong>
                                        ${escapeHtml(row.question_text)}
                                    </strong>

                                    <p>
                                        ${escapeHtml(row.answer_text || "No written response")}
                                    </p>

                                </div>


                                ${marking}

                            </article>
                        `;
                    }
                )
                .join(
                    ""
                );


        } catch {
            // Keep the live FTO screen running if one refresh fails.
        }
    }


    function renderParticipants(
        participants
    ) {

        const container =
            document.getElementById(
                "participantList"
            );


        const present =
            participants.filter(
                person =>
                    person.attendance ===
                    "present"
            );


        if (!present.length) {

            container.innerHTML =
                '<div class="live-no-participants">Waiting for trainees…</div>';

            return;
        }


        container.innerHTML =
            present.map(
                person => `
                    <div class="live-person">

                        <img
                            src="${person.avatarUrl}"
                            alt=""
                        >

                        <div>
                            <strong>
                                ${escapeHtml(person.displayName)}
                            </strong>

                            <small>
                                ${person.role.toUpperCase()}
                            </small>
                        </div>

                    </div>
                `
            )
            .join(
                ""
            );
    }


    async function refreshState() {

        try {
            const response =
                await fetch(
                    `/training/live/${sessionId}/state`
                );


            const state =
                await response.json();


            if (!state.ok) {
                return;
            }


            const banner =
                document.getElementById(
                    "liveConnectionBanner"
                );


            banner.hidden =
                true;


            if (
                Number(
                    state.currentSectionId
                ) !==
                Number(
                    currentSectionId
                )
            ) {
                currentSectionId =
                    Number(
                        state.currentSectionId
                    );


                quizOpen =
                    Boolean(
                        state.quizOpen
                    );


                showSection(
                    state.currentSectionId
                );

            } else {

                quizOpen =
                    Boolean(
                        state.quizOpen
                    );


                updateQuizButton();
            }


            renderParticipants(
                state.participants ||
                []
            );


            if (
                state.status ===
                "completed"
            ) {
                document
                    .getElementById(
                        "syncStatus"
                    )
                    .textContent =
                    "Session completed";


                document
                    .querySelectorAll(
                        ".live-controls button, .live-quiz-toggle"
                    )
                    .forEach(
                        button => {
                            button.disabled =
                                true;
                        }
                    );
            }


            refreshResponses();


        } catch {

            const banner =
                document.getElementById(
                    "liveConnectionBanner"
                );


            banner.hidden =
                false;


            document
                .getElementById(
                    "syncStatus"
                )
                .textContent =
                "Reconnecting…";
        }
    }


    showSection(
        currentSectionId
    );


    refreshState();


    setInterval(
        refreshState,
        2000
    );

</script>

</body>
</html>
