<%- include("partials/head", { title: "No Permissions" }) %>

<body class="permission-body">

    <main class="permission-page">

        <section class="permission-card">

            <!-- LOGO -->
            <div class="permission-logo">
                <img
                    src="/public/images/hcp-main.png"
                    alt="Hendry County Project"
                >
            </div>


            <!-- EYEBROW -->
            <p class="permission-eyebrow">
                HENDRY COUNTY PROJECT
            </p>


            <!-- TITLE -->
            <h1 class="permission-title">
                NO <span>PERMISSIONS</span>
            </h1>


            <!-- DESCRIPTION -->
            <p class="permission-description">
                You do not have permission to access this section
                of the Hendry County Project dashboard.
            </p>


            <!-- BACK BUTTON -->
            <a
                href="/dashboard"
                class="permission-back-button"
            >
                ← Back to Dashboard
            </a>


            <!-- FOOTER -->
            <p class="permission-footer">
                Access restricted by dashboard permissions
            </p>

        </section>

    </main>

</body>
</html>