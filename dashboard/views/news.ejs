<%- include("partials/head", { title: "News" }) %>

<body>

<%- include("partials/navbar") %>


<main class="page-container news-page">

    <section class="page-hero">

        <p class="eyebrow">
            PUBLIC
        </p>

        <h1>
            HCP
            <span>News</span>
        </h1>

        <p class="page-description">
            The latest news, announcements and development
            updates from the Hendry County Project.
        </p>

    </section>


    <% if (!posts.length) { %>

        <section class="news-empty">

            <div class="news-empty-icon">
                📰
            </div>

            <h2>
                No News Yet
            </h2>

            <p>
                There are currently no published news articles.
            </p>

        </section>

    <% } else { %>


        <section class="news-grid">

            <% posts.forEach(post => { %>

                <article class="news-card">

                    <% if (post.image) { %>

                        <a
                            href="/news/<%= post.slug %>"
                            class="news-image"
                        >

                            <img
                                src="<%= post.image %>"
                                alt="<%= post.title %>"
                            >

                        </a>

                    <% } %>


                    <div class="news-card-content">

                        <div class="news-meta">

                            <span>
                                NEWS
                            </span>

                            <time>
                                <%= new Date(post.createdAt).toLocaleDateString(
                                    "en-GB",
                                    {
                                        day: "numeric",
                                        month: "long",
                                        year: "numeric"
                                    }
                                ) %>
                            </time>

                        </div>


                        <h2>
                            <%= post.title %>
                        </h2>


                        <p>
                            <%= post.summary %>
                        </p>


                        <div class="news-card-footer">

                            <span>
                                By <%= post.author %>
                            </span>

                            <a href="/news/<%= post.slug %>">
                                Read Article →
                            </a>

                        </div>

                    </div>

                </article>

            <% }) %>

        </section>

    <% } %>

</main>


<script src="/public/js/dashboard.js"></script>

</body>
</html>